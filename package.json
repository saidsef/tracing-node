{
  "name": "@saidsef/tracing-node",
  "version": "7.0.2",
  "description": "tracing NodeJS - Wrapper for OpenTelemetry instrumentation packages",
  "main": "libs/index.mjs",
  "scripts": {
    "test": "node --trace-warnings --test --report-uncaught-exception libs/index.test.mjs",
    "lint": "eslint .",
    "rebuild": "rm -rfv node_modules/ package-lock.json && npm install --prod --omit=dev",
    "build-docs": "podman run --rm -v .:/docs docker.io/squidfunk/mkdocs-material:9 build",
    "clean-docs": "rm -rf site"
  },
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saidsef/tracing-node.git"
  },
  "keywords": [
    "opentracing",
    "apm",
    "trace",
    "tracing"
  ],
  "author": "Said Sef <saidsef@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 24.0.0"
  },
  "bugs": {
    "url": "https://github.com/saidsef/tracing-node/issues"
  },
  "homepage": "https://github.com/saidsef/tracing-node#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.78.0",
    "@opentelemetry/instrumentation-connect": "^0.66.0",
    "@opentelemetry/instrumentation-dns": "^0.66.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-fs": "^0.42.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.36.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "import-in-the-middle": "^3.5.2"
  },
  "devDependencies": {
    "eslint": "^10.12.0"
  },
  "peerDependencies": {
    "opentelemetry-instrumentation-elasticsearch": "^0.41.0"
  },
  "peerDependenciesMeta": {
    "opentelemetry-instrumentation-elasticsearch": {
      "optional": true
    }
  },
  "overrides": {
    "protobufjs": "^7.5.3"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
